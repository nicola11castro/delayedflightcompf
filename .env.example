# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# Any PostgreSQL database: local, Neon, Railway, Render, Supabase...
DATABASE_URL=postgresql://username:password@host:5432/database
# Set DATABASE_SSL=false only for a database that does not support TLS.
# DATABASE_SSL=false

# Long random string used to sign login cookies (required in production).
SESSION_SECRET=change-me-to-a-long-random-string

# production on a host, development locally
NODE_ENV=production

# Port the server listens on (hosts such as Railway/Render set this for you).
PORT=5000

# ---------------------------------------------------------------------------
# Admin access
# ---------------------------------------------------------------------------
# Comma-separated emails that become senior admins when they register or log in.
ADMIN_EMAILS=pncastrodorion@gmail.com

# Public URL of the deployed site (used in DocuSign return links).
APP_URL=https://www.delayedflightcomp.com

# ---------------------------------------------------------------------------
# Optional: OpenAI (chatbot + second-opinion eligibility pre-screen)
# Without a key the site still works: compensation comes from the APPR rules.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# Optional: outgoing email (claim confirmations, status updates, airline letters)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
# Where the "Email airline" button sends claim letters (an airline claims inbox,
# or your own inbox if you prefer to forward them manually).
AIRLINE_CLAIMS_EMAIL=

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------
# Google Sheets export (service account with edit access to the sheet)
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Airtable mirror of claims
AIRTABLE_BASE_ID=
AIRTABLE_API_KEY=

# DocuSign Power of Attorney e-signature
DOCUSIGN_CLIENT_ID=
DOCUSIGN_CLIENT_SECRET=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_ENVIRONMENT=demo

# ---------------------------------------------------------------------------
# Optional: file locations
# ---------------------------------------------------------------------------
# UPLOADS_DIR=uploads
# CONSENT_RECORDS_DIR=consent-records
# CONSENT_DOCS_DIR=consent-documents
# Set to false on hosts with read-only or ephemeral disks (records stay in the DB).
# CONSENT_FILES=true
